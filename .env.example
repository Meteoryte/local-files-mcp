# Local Files MCP environment settings.
# The setup command generates ~/.local-files-mcp/config.json; these env vars only override runtime behavior.

# host/port for local server
LOCAL_FILES_MCP_HOST=127.0.0.1
LOCAL_FILES_MCP_PORT=8765

# Set this after starting ngrok/cloudflared, or run: local-files-mcp detect-tunnel --save
# Example: https://abc123.ngrok-free.app
LOCAL_FILES_MCP_PUBLIC_URL=

# noauth is easiest for ChatGPT Developer Mode testing; oauth uses the pairing-code flow.
# Accepted: noauth, oauth
LOCAL_FILES_MCP_AUTH_MODE=noauth

# Only used in oauth mode. Generated per pairing session by: local-files-mcp pair
LOCAL_FILES_MCP_PAIRING_CODE_TTL_SECONDS=600
LOCAL_FILES_MCP_ACCESS_TOKEN_TTL_SECONDS=900
